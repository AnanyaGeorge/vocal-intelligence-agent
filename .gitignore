# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

